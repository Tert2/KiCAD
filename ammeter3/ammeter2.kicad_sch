	(text "INA181A2: 増幅率50倍\nR=8mOhm, Vref: ATtiny内部基準電圧, V0=a*Vref, V1=b*Vrefとして\nI = (a-b)Vref/(50*R)\n"
		(exclude_from_sim no)
		(at 179.324 171.704 0)
		(effects
			(font
				(size 1.27 1.27)
